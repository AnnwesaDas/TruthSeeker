# Backend API URL. Defaults to http://localhost:3000 if unset.
VITE_API_URL=http://localhost:3000

# Backend WebSocket URL. Defaults to VITE_API_URL with ws(s):// if unset.
VITE_WS_URL=ws://localhost:3000

# Optional: Cloudflare Turnstile site key (https://dash.cloudflare.com/?to=/:account/turnstile,
# free tier). If unset, the bot-protection widget doesn't render and
# verification is skipped gracefully. Must match the backend's
# TURNSTILE_SECRET_KEY (issued together as a pair).
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
