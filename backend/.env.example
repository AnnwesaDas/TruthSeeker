GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_long_random_jwt_secret_here

# Comma-separated list of frontend origins allowed to call this API and
# open a WebSocket connection, e.g.:
# FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Google Fact Check Tools API key (Google Cloud Console > enable "Fact Check
# Tools API" > Credentials > Create API key). Free tier, no billing required.
# If unset, fact-check evidence lookup is skipped gracefully.
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# Optional: Google Programmable Search Engine (https://programmablesearchengine.google.com/)
# for general trusted-news search, restricted to trusted domains. If either
# value is unset, general news search is skipped gracefully.
GOOGLE_CSE_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CSE_ID=your_programmable_search_engine_id_here

# URL of the hosted BERT classification service. Defaults to localhost for
# local development; set to your deployed model service's URL in production.
BERT_API_URL=http://localhost:5001

# Optional: Cloudflare Turnstile bot protection on signup/login
# (https://dash.cloudflare.com/?to=/:account/turnstile, free tier).
# If unset, bot verification is skipped gracefully. Must match the frontend's
# VITE_TURNSTILE_SITE_KEY (a site key and secret key are issued as a pair).
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Demo-safe mode: set to "true" to serve real, previously-verified responses
# for a small set of known claims (see backend/data/demoResponses.js)
# instead of calling any live API. Use this for live demos/interviews so
# they never depend on remaining Gemini quota. Leave unset for normal use.
USE_CACHED_DEMO=false
